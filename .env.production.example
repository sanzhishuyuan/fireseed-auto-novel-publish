# ============================================
# AI小说平台 - 生产环境变量模板
# 复制此文件为 .env.production 并填写真实值
# 切勿将 .env.production 提交到 Git！
# ============================================

# Node 运行环境
NODE_ENV=production

# JWT 签名密钥（随机64位字符串，可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# 管理员后台密码（请使用强密码）
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# 站点公开访问地址（用于重定向等）
NEXT_PUBLIC_URL=https://your-domain.com

# 端口
PORT=3000
