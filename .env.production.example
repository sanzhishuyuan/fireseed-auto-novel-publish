# ============================================
# AI小说平台 - 生产环境变量模板
# 复制此文件为 .env.production 并填写真实值
# 切勿将 .env.production 提交到 Git！
# ============================================

# Node 运行环境
NODE_ENV=production

# JWT 签名密钥（随机64位字符串，可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# 管理员后台密码（请使用强密码）
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# 站点公开访问地址（用于重定向等）
NEXT_PUBLIC_URL=https://your-domain.com

# 端口
PORT=3000

# ============================================
# SMTP 邮件配置（可选）
# 配置后，新用户注册时会发通知邮件到管理员邮箱
# QQ 邮箱的 SMTP 授权码获取：设置 → 账户 → POP3/SMTP 服务 → 生成授权码
# ============================================
# SMTP 服务器
SMTP_HOST=smtp.qq.com
# SMTP 端口（465=SSL, 587=TLS）
SMTP_PORT=465
# SMTP 账号（通常是完整邮箱地址）
SMTP_USER=your_email@qq.com
# SMTP 密码/授权码（QQ邮箱需使用授权码，非登录密码）
SMTP_PASS=your_smtp_authorization_code
# 管理员通知邮箱（谁接收新用户注册通知）
ADMIN_EMAIL=your_email@qq.com
